# ============================================================
# Telegram AI Auto-Seller SaaS — ការកំណត់បរិស្ថាន
# ចម្លងឯកសារនេះទៅ `.env` រួចបំពេញតម្លៃ។
#   cp .env.example .env
# ============================================================

# ---------- ប៉ុន្តែ Admin Bot (Aiogram / Bot API) ----------
# Token ពី @BotFather។ ដាក់ "MOCK" បើចង់សាកល្បងដោយគ្មានបណ្តាញ។
BOT_TOKEN=MOCK

# Telegram user ID របស់ម្ចាស់ (តែឯងគត់ដែលចូល Panel បាន)។
# រក ID តាម @userinfobot
OWNER_ID=000000000

# Admin ជំនួយ (សរសេរឆ្លាស់ក្នុងក្បែរក្រហម, អាចទទេ)។
# ចំណាំ៖ Admin ជំនួយមិនអាចកែ Settings ឬ Admins បានទេ។
ADMIN_IDS=

# ---------- ម៉ាស៊ីន ----------
# តំបន់ពេលវេលា សម្រាប់របាយការណ៍ និង Working hours
TIMEZONE=Asia/Phnom_Penh
# បើកសម្រាប់តេស្ត៖ true = មិនប្រើ Token ពិត ប្រើ Mock Telegram session ជំនួស
USE_MOCK_BOT=false

# ---------- មូលដ្ឋានទិន្នន័យ ----------
# SQLite តាមរយៈ aiosqlite។ មិនត្រូវកែលើកវី លើកលែងតែចង់ផ្លាស់ប្តូរទីតាំង។
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ---------- សុវត្ថិភាព ----------
# Fernet key សម្រាប់បិទបាំង (encrypt) Telethon session string (ជំហានទី ២)។
# បង្កើត៖  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# កុំទុក key នេះក្នុង DB ឬ log ទាញយកវាទៅកន្លែងសុវត្ថិភាព។
SESSION_FERNET_KEY=

# ---------- ម៉ាស៊ីន AI ----------
# ជម្រើស៖ mock | qoder_cli | openai | ollama
AI_BACKEND=mock

# --- ជម្រើស A: Qoder CLI (subprocess, គ្មាន API key) ---
# ពិនិត្យ license/usage terms របស់ CLI មុននឹងប្រើក្នុងប្រព័ន្ធពាណិជ្ជកម្មដំណើរការខ្លួនឯង។
# ប្រើ {prompt} ជាកន្លែងវាង។ ខ្សែត្រូវបំបែកដោយ shlex ហើយមិនឆ្លងកាត់ shell ទេ។
QODER_CLI_BIN=qoder
QODER_CLI_ARGS=-p {prompt}
QODER_CLI_TIMEOUT=90

# --- ជម្រើស B: OpenAI-compatible endpoint (vLLM, LM Studio, OpenRouter...) ---
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen3-8b-flash

# --- ជម្រើស C: Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# ចំនួនសារប្រវត្តិដែលផ្តល់ឱ្យ AI (context memory)
AI_HISTORY_LIMIT=20
AI_TIMEOUT=60

# ---------- Userbot (ជំហានទី ២ — Telethon) ----------
# ពី my.telegram.org/api/credentials លើគណនីដែលអ្នកជាម្ចាស់
TG_API_ID=
TG_API_HASH=

# កម្រិតការផ្ញើ ក្នុងមួយគណនី (anti-ban)។ កុំបង្កើនលើស 50/h · 200/ថ្ងៃ ទោះករណីណា។
USERBOT_CAP_HOUR=50
USERBOT_CAP_DAY=200
# ចំនួន slot ចុងក្រោយបង្អស់ដែលទុកសម្រាប់ផ្ញើ Code ឱ្យអតិថិជនដែលបានបង់ប្រាក់
USERBOT_DELIVERY_RESERVE=10

# ---------- ការកំណត់លំនាំដើម (កែបានក្នុង Panel) ----------
WORKING_HOURS=08:00-23:00
STOCK_ALERT_THRESHOLD=5
LANGUAGE=km
