# ============================================================
# Telegram AI Auto-Seller SaaS — ការកំណត់បរិស្ថាន
# ចម្លងឯកសារនេះទៅ `.env` រួចបំពេញតម្លៃ។
#   cp .env.example .env
# ============================================================

# ---------- ប៉ុន្តែ Admin Bot (Aiogram / Bot API) ----------
# Token ពី @BotFather។ ដាក់ "MOCK" បើចង់សាកល្បងដោយគ្មានបណ្តាញ។
BOT_TOKEN=MOCK

# Telegram user ID របស់ម្ចាស់ (តែឯងគត់ដែលចូល Panel បាន)។
# រក ID តាម @userinfobot
OWNER_ID=000000000

# Admin ជំនួយ (សរសេរឆ្លាស់ក្នុងក្បែរក្រហម, អាចទទេ)។
# ចំណាំ៖ Admin ជំនួយមិនអាចកែ Settings ឬ Admins បានទេ។
ADMIN_IDS=

# ---------- ម៉ាស៊ីន ----------
# តំបន់ពេលវេលា សម្រាប់របាយការណ៍ និង Working hours
TIMEZONE=Asia/Phnom_Penh
# បើកសម្រាប់តេស្ត៖ true = មិនប្រើ Token ពិត ប្រើ Mock Telegram session ជំនួស
USE_MOCK_BOT=false

# ---------- មូលដ្ឋានទិន្នន័យ ----------
# SQLite តាមរយៈ aiosqlite។ មិនត្រូវកែលើកវី លើកលែងតែចង់ផ្លាស់ប្តូរទីតាំង។
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ---------- សុវត្ថិភាព ----------
# Fernet key សម្រាប់បិទបាំង (encrypt) Telethon session string (ជំហានទី ២)។
# បង្កើត + សរសេរចូល .env ដោយស្វ័យប្រវត្តិ៖  python scripts/generate_keys.py --write
# (ឬបង្ហាញ key សិន៖ python scripts/generate_keys.py)
# ត្រូវការសម្រាប់ /addaccount — បើទទេ Bot បដិសេធ login ហើយប្រាប់ឱ្យបង្កើត key។
# កុំទុក key នេះក្នុង DB ឬ log ទាញយកវាទៅកន្លែងសុវត្ថិភាព។
SESSION_FERNET_KEY=

# ---------- ម៉ាស៊ីន AI ----------
# ជម្រើស៖ groq | mock | qoder_cli | openai | ollama
# openai = Qoder Proxy (port 3000) ដែលត្រូវរត់មុន៖ ./scripts/run_qoder_proxy.sh
# គ្មាន Proxy? ប្រើ groq (ឥតគិតថ្លៃ + លឿន) ជំនួស
# Fallback ស្វ័យប្រវត្តិ: ជម្រើសចម្បង → groq → openai → mock
AI_BACKEND=openai

# --- ជម្រើស ០: Groq (ណែនាំ — ឥតគិតថ្លៃ) ---
# យក Key ពី https://console.groq.com/keys
# ចំណាំ: llama-3.1/3.3-70b-versatile ត្រូវបាន decommissioned ឬបិទប្រើតាម key។
# ម៉ូដែលដែលដំណើរការឥឡូវ: qwen/qwen3.8-27b · openai/gpt-oss-120b · allam-2-7b
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- ជម្រើស A: Qoder CLI (subprocess, គ្មាន API key) ---
# ពិនិត្យ license/usage terms របស់ CLI មុននឹងប្រើក្នុងប្រព័ន្ធពាណិជ្ជកម្មដំណើរការខ្លួនឯង។
# ប្រើ {prompt} ជាកន្លែងវាង។ ខ្សែត្រូវបំបែកដោយ shlex ហើយមិនឆ្លងកាត់ shell ទេ។
# ចំណាំ: `--tools` ជា variadic ដូច្នេះត្រូវមាន `--` មុន {prompt}។
QODER_CLI_BIN=qodercli
QODER_CLI_ARGS=-p --no-session-persistence --tools "" -- {prompt}
QODER_CLI_TIMEOUT=90

# --- ជម្រើស A2: Qoder Proxy (scripts/qoder_proxy.py) ---
# ដំឡើង CLI: ./scripts/install_qoder.sh   រត់ Proxy: ./scripts/run_qoder_proxy.sh
QODER_PROXY_HOST=127.0.0.1
QODER_PROXY_PORT=3000
# តិចជាង AI_TIMEOUT ដើម្បីកុំឱ្យ Bot timeout ដំណាលនឹង CLI
QODER_PROXY_TIMEOUT=80
QODER_PROXY_CONCURRENCY=2
# ទទេ = ប្រើម៉ូដែលលំនាំដើមរបស់ CLI
QODER_PROXY_MODEL=

# --- ជម្រើស B: OpenAI-compatible endpoint (vLLM, LM Studio, OpenRouter...) ---
# 127.0.0.1:3000 = Qoder Proxy; ឈ្មោះ model មិនសំខាន់ទេ (Proxy ចោលវា)
OPENAI_BASE_URL=http://127.0.0.1:3000/v1
OPENAI_API_KEY=sk-qoder-proxy-local
OPENAI_MODEL=qoder-cli

# --- ជម្រើស C: Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# ចំនួនសារប្រវត្តិដែលផ្តល់ឱ្យ AI (context memory)
AI_HISTORY_LIMIT=20
# Qoder CLI យឺតជាង Groq — 90s គ្រាន់សម្រាប់វា
AI_TIMEOUT=90

# ---------- Userbot (ជំហានទី ២ — Telethon) ----------
# មិនចាំបាច់ទេ! api_id/api_hash ជា *របស់គណនីនីមួយៗ* ហើយ admin វាយបញ្ចូលតាម chat
# (/addaccount → my.telegram.org → api_id → api_hash) រួច Bot រក្សាទុកជា Fernet ក្នុង DB។
# ទុកពីរបន្ទាត់នេះទទេ លុះត្រាតែចង់ fallback សម្រាប់គណនីចាស់ដែល login មុនមុខងារនេះ។
# ត្រូវការតែ SESSION_FERNET_KEY ខាងលើ (សម្រាប់ Encrypt session + creds)។
TG_API_ID=
TG_API_HASH=

# កម្រិតការផ្ញើ ក្នុងមួយគណនី (anti-ban)។ កុំបង្កើនលើស 50/h · 200/ថ្ងៃ ទោះករណីណា។
USERBOT_CAP_HOUR=50
USERBOT_CAP_DAY=200
# ចំនួន slot ចុងក្រោយបង្អស់ដែលទុកសម្រាប់ផ្ញើ Code ឱ្យអតិថិជនដែលបានបង់ប្រាក់
USERBOT_DELIVERY_RESERVE=10

# ---------- ការកំណត់លំនាំដើម (កែបានក្នុង Panel) ----------
WORKING_HOURS=08:00-23:00
STOCK_ALERT_THRESHOLD=5
LANGUAGE=km
