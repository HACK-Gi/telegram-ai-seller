# Fernet key សម្រាប់ sign pending token រវាង `/send_otp` → `/verify_otp`
# បង្កើត៖ .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ខក  → app បង្កើត key បណ្តោះអាសន្ន per isolate (ភ្ញៀវត្រូវសុំ OTP ឡើងវិញ ពេល isolate ផ្លាស់ប្តូរ)
# នៅ production: `vercel env add SESSION_WEB_SECRET production`
SESSION_WEB_SECRET=

# ទំហំ TTL (វិនាទី) របស់ pending token — default 600
SESSION_WEB_TTL=600
# វិនាទី រង់ចាំ Telegram ឆ្លើយ — default 30 (ត្រូវតែ < maxDuration របស់ Vercel = ៦០)
SESSION_WEB_TIMEOUT=30

# តែសម្រាប់រត់ក្នុងកុំព្យូទ័រ (Vercel មិនប្រើ)
SESSION_WEB_HOST=127.0.0.1
SESSION_WEB_PORT=5050

# URL សាធារណៈរបស់ app នี้ ពេម ដាក់ CORS ត្រឹម origin របស់វា
SESSION_WEB_URL=
