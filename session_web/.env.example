# Fernet key សម្រាប់ sign pending token រវាង `/send_otp` → `/verify_otp`
# បង្កើត៖ .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ខ្វះ  → app បង្កើត key បណ្តោះអាសន្ន per isolate (ភ្ញៀវត្រូវសុំ OTP ឡើងវិញ ពេល isolate ផ្លាស់ប្តូរ)
# នៅ production: ដាក់ក្នុង Render Dashboard → Environment (sync:false ក្នុង render.yaml)
#                ឬ `vercel env add SESSION_WEB_SECRET production` បើ deploy លើ Vercel
SESSION_WEB_SECRET=

# ទំហំ TTL (វិនាទី) របស់ pending token — default 600
SESSION_WEB_TTL=600
# វិនាទី រង់ចាំ Telegram ឆ្លើយ — default 30។ Render ឱ្យ 120s ទើបដាក់ 45 បាន
# (Vercel maxDuration 60s មិនគ្រប់ — បើ deploy លើ Vercel កុំដាក់លើស ៤៥)
SESSION_WEB_TIMEOUT=45

# `PORT` របស់ Render/Heroku មានសិទ្ធិខ្ពស់ជាង ពេលរត់ `python app.py` (gunicorn រំលងប្លុកនេះ)
SESSION_WEB_HOST=0.0.0.0
SESSION_WEB_PORT=5050

# URL សាធារណៈរបស់ app នេះ ដើម្បីដាក់ CORS ត្រឹម origin របស់វា
SESSION_WEB_URL=
