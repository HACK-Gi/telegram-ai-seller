
# ============================================================
# Telegram AI Auto-Seller SaaS — ការកំណត់បរិស្ថាន
# ចម្លងឯកសារនេះទៅ `.env` រួចបំពេញតម្លៃ។
#   cp .env.example .env
# ============================================================

# ---------- ប៉ុន្តែ Admin Bot (Aiogram / Bot API) ----------
# Token ពី @BotFather។ ដាក់ "MOCK" បើចង់សាកល្បងដោយគ្មានបណ្តាញ។
BOT_TOKEN=8540454571:AAH2KU3Ivrvp18s0-QX0Gy3ILsIpSV7otxU

# Telegram user ID របស់ម្ចាស់ (តែឯងគត់ដែលចូល Panel បាន)។
# រក ID តាម @userinfobot
OWNER_ID=7950112112

# Admin ជំនួយ (សរសេរឆ្លាស់ក្នុងក្បែរក្រហម, អាចទទេ)។
# ចំណាំ៖ Admin ជំនួយមិនអាចកែ Settings ឬ Admins បានទេ។
ADMIN_IDS=

# ---------- ម៉ាស៊ីន ----------
# តំបន់ពេលវេលា សម្រាប់របាយការណ៍ និង Working hours
TIMEZONE=Asia/Phnom_Penh
# ថេរ ពេលសាកល្បង៖ 1 = មិនប្រើ Token ពិត ប្រើ Mock Telegram session
USE_MOCK_BOT=false

# ---------- មូលដ្ឋានទិន្នន័យ ----------
# SQLite តាមរយៈ aiosqlite។ មិនត្រូវកែលើកវី លើកលែងតែចង់ផ្លាស់ប្តូរទីតាំង។
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ---------- សុវត្ថិភាព ----------
# Fernet key សម្រាប់បិទបាំង (encrypt) Telethon session string (ជំហានទី ២)។
# បង្កើត៖  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# កុំទុក key នេះក្នុង DB ឬ log ទាញយកវាទៅកន្លែងសុវត្ថិភាព។
SESSION_FERNET_KEY=9p1tpVhFsxGDTav9fYbD8c5204BBhTlKRP3i531VaDw=

# ---------- ម៉ាស៊ីន AI ----------
# ជម្រើស៖ groq | mock | qoder_cli | openai | ollama
# ណែនាំ: openai (= Qoder Proxy តាម port 3000) — គុណភាពខ្ពស់ តែយឺតជាង Groq
# Fallback ស្វ័យប្រវត្តិ: openai → groq → mock
AI_BACKEND=openai

# --- ជម្រើស ០: Groq (ណែនាំ — ឥតគិតថ្លៃ) ---
# យក Key ពី https://console.groq.com/keys
# បន្ទាប់ពីបាន Key ប្តូរ AI_BACKEND=groq
# ចំណាំ: llama-3.1-70b-versatile ត្រូវ decommissioned ហើយ (Error 400)
#        llama-3.3-70b-versatile ក៏មិនមានសម្រាប់ key នេះដែរ (model_not_found)
# ម៉ូដែលដែលតេស្តឆ្លងហើយ: qwen/qwen3.8-27b · openai/gpt-oss-120b · allam-2-7b
GROQ_API_KEY=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
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- ជម្រើស A: Qoder CLI (subprocess, គ្មាន API key) ---
# ពិនិត្យ license/usage terms របស់ CLI មុននឹងប្រើក្នុងប្រព័ន្ធពាណិជ្ជកម្មដំណើរការខ្លួនឯង។
# ប្រើ {prompt} ជាកន្លែងវាង។ ខ្សែត្រូវបំបែកដោយ shlex ហើយមិនឆ្លងកាត់ shell ទេ។
# ចំណាំ: `--tools` ជា variadic ដូច្នេះត្រូវមាន `--` មុន {prompt}  otherwise
#        CLI យក prompt ទៅជាឈ្មោះ tool ហើយចេញ exit 42។
QODER_CLI_BIN=qodercli
QODER_CLI_ARGS=-p --no-session-persistence --tools "" -- {prompt}
QODER_CLI_TIMEOUT=90

# --- ជម្រើស A2: Qoder Proxy (scripts/qoder_proxy.py — ត្រូវរត់មុន) ---
# ដំណើរការ: ./scripts/run_qoder_proxy.sh   (ឬ --bg សម្រាប់ background)
# តាំងពី Port 3000 រហូតដល់ 3099 គ្រាន់តែប្តូរលេខនៅទីនេះ
QODER_PROXY_HOST=127.0.0.1
QODER_PROXY_PORT=3000
# តិចជាង AI_TIMEOUT ដើម្បីកុំឱ្យ Bot timeout ដំណាលនឹង CLI
QODER_PROXY_TIMEOUT=80
QODER_PROXY_CONCURRENCY=2
# ទទេ = ប្រើម៉ូដែលលំនាំដើមរបស់ CLI (ឥឡូវ: Qwen3.8-Flash)
QODER_PROXY_MODEL=

# --- ជម្រើស B: OpenAI-compatible endpoint (vLLM, LM Studio, OpenRouter...) ---
# ឥឡូវ 127.0.0.1:3000 = Qoder Proxy ដែល AI_BACKEND=openai ចង្អុលទៅ
OPENAI_BASE_URL=http://127.0.0.1:3000/v1
OPENAI_API_KEY=sk-qoder-proxy-local
OPENAI_MODEL=qoder-cli

# --- ជម្រើស C: Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# ចំនួនសារប្រវត្តិដែលផ្តល់ឱ្យ AI (context memory)
AI_HISTORY_LIMIT=20
# Qoder CLI យឺតជាង Groq — 90s គ្រាន់សម្រាប់វា
AI_TIMEOUT=90

# ---------- Userbot (ជំហានទី ២ — Telethon) ----------
# ពី my.telegram.org/api/credentials លើគណនីដែលអ្នកជាម្ចាស់
TG_API_ID=27616997
TG_API_HASH=58e721b827ef6ba718f31794c5ca4aec

# កម្រិតការផ្ញើក្នុងមួយគណនី (anti-ban) — កុំបង្កើនលើស 50/h · 200/ថ្ងៃ
USERBOT_CAP_HOUR=50
USERBOT_CAP_DAY=200
USERBOT_DELIVERY_RESERVE=10

# ---------- ការកំណត់លំនាំដើម (កែបានក្នុង Panel) ----------
WORKING_HOURS=08:00-23:00
